from calibre.web.feeds.news import BasicNewsRecipe

class LinguisticsDigest(BasicNewsRecipe):
    title = 'Linguistics Digest'
    oldest_article = 30
    max_articles_per_feed = 20
    auto_cleanup = True

    feeds = [
        ('Language Log',
         'https://languagelog.ldc.upenn.edu/nll/?feed=rss2'),

        ('Linguist List',
         'https://linguistlist.org/feed/'),

        ('The Gradient',
         'https://thegradient.pub/rss/'),

        ('Hugging Face Blog',
         'https://huggingface.co/blog/feed.xml'),
    ]
